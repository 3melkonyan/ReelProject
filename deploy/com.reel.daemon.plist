<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.reel.daemon</string>
  <key>ProgramArguments</key><array>
    <!-- caffeinate -s: the Mac does not sleep while the worker runs on AC power (server use);
         on battery it sleeps normally. Closing the lid still sleeps a MacBook. -->
    <string>/usr/bin/caffeinate</string><string>-s</string>
    <string>__ROOT__/.venv/bin/python</string>
    <string>-m</string><string>reel.cli</string><string>run</string>
  </array>
  <key>WorkingDirectory</key><string>__ROOT__</string>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__ROOT__/logs/daemon.log</string>
  <key>StandardErrorPath</key><string>__ROOT__/logs/daemon.log</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONUNBUFFERED</key><string>1</string>
  </dict>
</dict></plist>
