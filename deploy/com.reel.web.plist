<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.reel.web</string>
  <!-- The dashboard on http://127.0.0.1:8765 only; it is not reachable from other devices
       unless the optional com.reel.tunnel agent is installed (install.sh with the share flag). -->
  <key>ProgramArguments</key><array>
    <string>__ROOT__/.venv/bin/python</string>
    <string>-m</string><string>uvicorn</string><string>reel.web.app:app</string>
    <string>--host</string><string>127.0.0.1</string>
    <string>--port</string><string>8765</string>
  </array>
  <key>WorkingDirectory</key><string>__ROOT__</string>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__ROOT__/logs/web.log</string>
  <key>StandardErrorPath</key><string>__ROOT__/logs/web.log</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONUNBUFFERED</key><string>1</string>
  </dict>
</dict></plist>
